{
  "data": {
    "train_path": "data/processed/sst2/train",
    "val_path": "data/processed/sst2/validation",
    "test_path": "data/processed/sst2/test"
  },
  "model": {
    "embedding_dim": 768,
    "hidden_dim": 256,
    "num_classes": 2,
    "excitatory_ratio": 0.5
  },
  "lif": {
    "tau": {
      "learnable": true,
      "mode": "per_group",
      "min": 0.5,
      "max": 20.0,
      "init": 2.0
    },
    "threshold": {
      "learnable": false,
      "mode": "shared",
      "min": 0.1,
      "max": 5.0,
      "init": 0.0
    }
  },
  "training": {
    "batch_size": 32,
    "epochs": 10,
    "lr": 0.001,
    "weight_decay": 1e-05,
    "num_workers": 0,
    "pin_memory": false,
    "deterministic": false,
    "seed": 42
  },
  "runtime": {
    "device": "cuda",
    "save_dir": "results/no_routing",
    "run_name": "sst2_no_routing_run1",
    "save_best_only": false
  }
}